# k6 built with xk6-kubernetes: ~75 MB, and reproducible in one command. Keeping
# it out of history rather than carrying a binary in the repo forever.
#   xk6 build --with github.com/grafana/xk6-kubernetes@v0.9.0 --output k6-xk6
k6-xk6

# Run output: large, machine-specific, and regenerated by every run.
*/results/

# Charts extracted from git tags by fetch-chart.sh; reproducible, not source.
ivpol-scaling/.charts/

# TLS private keys, certs, and the CA bundle handed to Kyverno: regenerated by
# setup-registry.sh, host- and run-specific. cosign.key/.pub are already
# tracked and stay that way.
ivpol-scaling/registry/keys/*.key
ivpol-scaling/registry/keys/*.crt
ivpol-scaling/registry/keys/ca-bundle.pem
ivpol-scaling/registry/keys/*.pub
