FROM mcr.microsoft.com/oss/go/microsoft/golang:1.26.9-azurelinux3.0 AS builder

ENV GOPATH=/go \
    PATH=/usr/local/go/bin:/go/bin:/usr/local/bin:/usr/bin:$PATH \
    CGO_ENABLED=1 \
    FIPS_ENABLED=1

RUN mkdir -p /go && \
    tdnf install -y \
        ca-certificates \
        gcc \
        git \
        make \
        shadow-utils && \
    tdnf clean all

WORKDIR /app
COPY . .

ARG BUILD_TAGS
ARG GOEXPERIMENT
ARG LD_FLAGS
ARG MAIN_FILE
ARG OUTPUT=kubectl-kyverno

ARG TARGETARCH

# Private Nirmata modules need a git credential. Passed as a BuildKit secret, not a
# build arg, so it never lands in an image layer:
#
#   docker buildx build --secret id=nirmata_module_token,env=NIRMATA_MODULE_TOKEN ...
#
# The mount is optional. No git-config cleanup needed: this is a builder stage and
# only the compiled binary is copied into the final image.
RUN --mount=type=secret,id=nirmata_module_token,required=false \
    set -e; \
    export GOPRIVATE='github.com/nirmata/*'; \
    if [ -f /run/secrets/nirmata_module_token ]; then \
        git config --global \
            url."https://x-access-token:$(cat /run/secrets/nirmata_module_token)@github.com/nirmata/".insteadOf \
            "https://github.com/nirmata/"; \
    fi; \
    GOOS=linux GOARCH=$TARGETARCH \
    BUILD_TAGS=${BUILD_TAGS} GOEXPERIMENT=${GOEXPERIMENT} \
    CGO_ENABLED=1 FIPS_ENABLED=1 \
    go build -ldflags="${LD_FLAGS}" -o /app/${OUTPUT} ${MAIN_FILE}

RUN groupadd --system appgroup && \
    useradd --system --uid 1001 --gid appgroup --home-dir /nonexistent --shell /usr/sbin/nologin appuser && \
    chown appuser:appgroup /app/${OUTPUT}

FROM mcr.microsoft.com/azurelinux/distroless/base:3.0

ARG OUTPUT=kubectl-kyverno

COPY --from=builder /etc/passwd /etc/passwd

COPY --from=builder /etc/group /etc/group

COPY --from=builder /app/${OUTPUT} /${OUTPUT}

COPY --from=builder /etc/ssl/certs /etc/ssl/certs

USER 1001

ENTRYPOINT ["/kubectl-kyverno"]
